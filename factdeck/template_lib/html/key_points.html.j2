{% if page.variant == "evidence_takeaways" %}{% include "evidence_takeaways.html.j2" %}{% else %}
{# Key-points — tonal cards with accent rail + small index; cards and type are sized to the content
   (fill._kp_scale), so a light page is a centred band of cards, not tall empty boxes. #}
{% set items = page["items"] %}
{% set sc = page.scale or {"body_pt": 14.5, "head_pt": 22, "sub_pt": 14, "card_h": 500} %}
{% set n = items|length %}
{% set cols = n if n <= 6 else 6 %}
{# spare height goes 30 % above the cards, 70 % below: anchored under the title, not floating mid-page #}
{% set spare = page.zones_px.body_card.h - 12 - sc.card_h - (90 if page.takeaway else 0) %}
{% set lift = (8 + (spare * 0.3 if spare > 0 else 0))|round|int %}
<style>
.L-tl-kp{background:var(--canvas)}
.L-tl-kp .section{
  position:absolute;left:{{ page.zones_px.header.x }}px;top:{{ page.zones_px.header.y }}px;
  width:{{ page.zones_px.header.w }}px;height:{{ page.zones_px.header.h }}px;
  font-size:12pt;font-weight:600;color:var(--caption);letter-spacing:0.12em;
  white-space:nowrap;overflow:hidden;text-transform:uppercase
}
.L-tl-kp .headline{
  position:absolute;left:{{ page.zones_px.headline.x }}px;top:{{ page.zones_px.headline.y }}px;
  width:{{ page.zones_px.headline.w }}px;height:{{ page.zones_px.headline.h }}px;
  font-size:30pt;font-weight:700;color:var(--headline);white-space:nowrap;overflow:hidden;
  display:flex;align-items:center;letter-spacing:-0.02em
}
.L-tl-kp .body-card{
  position:absolute;left:{{ page.zones_px.body_card.x }}px;top:{{ page.zones_px.body_card.y }}px;
  width:{{ page.zones_px.body_card.w }}px;height:{{ page.zones_px.body_card.h }}px;
  background:transparent;border:none;border-radius:0;padding:{{ lift }}px 4px 4px;
  display:flex;flex-direction:column;justify-content:flex-start;gap:20px
}
.L-tl-kp .pillars{
  display:grid;grid-template-columns:repeat({{ cols }},1fr);grid-template-rows:{{ sc.card_h }}px;gap:20px;min-height:0
}
.L-tl-kp .pillar{
  position:relative;border:none;border-radius:14px;background:var(--paper);
  box-shadow:0 8px 28px var(--shadow-soft), 0 1px 0 rgba(255,255,255,0.7) inset;
  padding:28px 22px 24px 26px;display:flex;flex-direction:column;align-items:flex-start;text-align:left;
  overflow:hidden
}
.L-tl-kp .pillar::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--accent);border-radius:14px 0 0 14px
}
.L-tl-kp .pillar.is-lead{
  background:linear-gradient(165deg,var(--primary) 0%,var(--accent) 100%);
  box-shadow:0 12px 32px var(--shadow);color:var(--on-accent)
}
.L-tl-kp .pillar.is-lead::before{background:rgba(255,255,255,0.35)}
.L-tl-kp .pillar .top{display:flex;align-items:baseline;gap:12px;margin-bottom:10px;max-width:100%}
.L-tl-kp .pillar .idx{font-size:13pt;font-weight:700;line-height:1.2;color:var(--accent);letter-spacing:0.06em;white-space:nowrap}
.L-tl-kp .pillar.is-lead .idx{color:var(--accent-on-dark)}
.L-tl-kp .pillar .tag{
  font-size:11pt;font-weight:700;color:var(--accent);border:none;border-radius:0;
  padding:0;letter-spacing:0.14em;text-transform:uppercase;
  white-space:nowrap;overflow:hidden;max-width:100%;background:transparent
}
.L-tl-kp .pillar.is-lead .tag{color:var(--accent-on-dark)}
.L-tl-kp .pillar .heading{
  font-size:{{ sc.head_pt }}pt;
  font-weight:700;color:var(--headline);line-height:1.18;margin-bottom:10px;
  overflow:hidden;max-width:100%;letter-spacing:-0.015em;position:relative;z-index:1
}
.L-tl-kp .pillar.is-lead .heading{color:#fff}
.L-tl-kp .pillar .sub{
  font-size:{{ sc.sub_pt }}pt;font-weight:600;color:var(--accent);margin-bottom:10px;overflow:hidden;max-width:100%;
  position:relative;z-index:1
}
.L-tl-kp .pillar.is-lead .sub{color:var(--accent-on-dark)}
.L-tl-kp .pillar .body{
  font-size:{{ sc.body_pt }}pt;font-weight:400;color:var(--muted);
  line-height:1.5;overflow:hidden;max-width:100%;position:relative;z-index:1
}
.L-tl-kp .pillar.is-lead .body{color:rgba(255,255,255,0.88)}
.L-tl-kp .takeaway{
  border:none;border-radius:10px;padding:14px 20px 14px 22px;
  font-size:15pt;font-weight:700;color:var(--primary);overflow:hidden;white-space:nowrap;
  background:var(--takeaway-bg);position:relative;box-shadow:none
}
.L-tl-kp .takeaway::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--accent);border-radius:10px 0 0 10px
}
.L-tl-kp .foot-page{
  position:absolute;left:{{ page.zones_px.footer_page.x }}px;top:{{ page.zones_px.footer_page.y }}px;
  width:{{ page.zones_px.footer_page.w }}px;height:{{ page.zones_px.footer_page.h }}px;
  font-size:11pt;font-weight:600;color:var(--caption)
}
.L-tl-kp .foot-src{
  position:absolute;left:{{ page.zones_px.footer_source.x }}px;top:{{ page.zones_px.footer_source.y }}px;
  width:{{ page.zones_px.footer_source.w }}px;height:{{ page.zones_px.footer_source.h }}px;
  font-size:11pt;font-weight:400;color:var(--caption);text-align:right;overflow:hidden;white-space:nowrap
}
</style>
<section class="slide L-tl-kp" id="{{ page.id }}" data-template="{{ page.template_id }}" data-family="key_points" data-variant="{{ page.variant }}" data-theme="{{ page.theme_name }}">
  {% if page.section %}<div class="section" data-slot="section">{{ page.section }}</div>{% endif %}
  <div class="headline" data-slot="title">{{ page.title }}</div>
  <div class="body-card" data-shape="body-card">
    <div class="pillars" data-slot="items" data-count="{{ n }}">
      {% for it in items %}
      <div class="pillar{% if loop.first and n <= 4 %} is-lead{% endif %}" data-item="{{ it.index }}" data-check="fit">
        <div class="top"><div class="idx" aria-hidden="true">{% if it.index < 10 %}0{% endif %}{{ it.index }}</div>
        {% if it.tag %}<div class="tag" data-slot="tag">{{ it.tag }}</div>{% endif %}</div>
        <div class="heading" data-slot="heading">{{ it.heading }}</div>
        {% if it.sub %}<div class="sub" data-slot="sub">{{ it.sub }}</div>{% endif %}
        {% if it.body %}<div class="body" data-slot="body">{{ it.body }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% if page.takeaway %}<div class="takeaway" data-slot="takeaway">{{ page.takeaway }}</div>{% endif %}
  </div>
  {% if page.page %}<div class="foot-page" data-slot="page" data-chrome>{{ page.page }}</div>{% endif %}
  {% if page.source %}<div class="foot-src" data-slot="source" data-chrome>{{ page.source }}</div>{% endif %}
</section>
{% endif %}
