{# Comparison — dual tonal panels with filled header bands; not twin outline boxes. #}
{% set left = page["left_items"] %}
{% set right = page["right_items"] %}
{% set rows = page["rows"] %}
{# bullet panels are sized to the fuller side (fill._cmp_scale); spare height goes 30 % above, 70 % below #}
{% set sc = page.scale or {"item_pt": 15, "col_h": 520} %}
{% set spare = page.zones_px.body_card.h - 12 - sc.col_h - (90 if page.takeaway else 0) %}
{% set lift = 8 if page.variant == "table_2n" else (8 + (spare * 0.3 if spare > 0 else 0))|round|int %}
<style>
.L-tl-cmp{background:var(--canvas)}
.L-tl-cmp .section{
  position:absolute;left:{{ page.zones_px.header.x }}px;top:{{ page.zones_px.header.y }}px;
  width:{{ page.zones_px.header.w }}px;height:{{ page.zones_px.header.h }}px;
  font-size:12pt;font-weight:600;color:var(--caption);letter-spacing:0.12em;
  white-space:nowrap;overflow:hidden;text-transform:uppercase
}
.L-tl-cmp .headline{
  position:absolute;left:{{ page.zones_px.headline.x }}px;top:{{ page.zones_px.headline.y }}px;
  width:{{ page.zones_px.headline.w }}px;height:{{ page.zones_px.headline.h }}px;
  font-size:30pt;font-weight:700;color:var(--headline);white-space:nowrap;overflow:hidden;
  display:flex;align-items:center;letter-spacing:-0.02em
}
.L-tl-cmp .body-card{
  position:absolute;left:{{ page.zones_px.body_card.x }}px;top:{{ page.zones_px.body_card.y }}px;
  width:{{ page.zones_px.body_card.w }}px;height:{{ page.zones_px.body_card.h }}px;
  background:transparent;border:none;border-radius:0;padding:{{ lift }}px 4px 4px;
  display:flex;flex-direction:column;gap:18px
}
.L-tl-cmp .cols{
  flex:0 0 {{ sc.col_h }}px;display:grid;grid-template-columns:1fr 48px 1fr;gap:0;min-height:0;align-items:stretch
}
.L-tl-cmp .col{
  display:flex;flex-direction:column;min-width:0;overflow:hidden;
  background:var(--paper);border-radius:14px;
  box-shadow:0 8px 28px var(--shadow-soft);padding:0
}
.L-tl-cmp .col.is-right{background:var(--surface)}
.L-tl-cmp .col-label{
  font-size:16pt;font-weight:700;color:var(--on-accent);padding:16px 22px;
  background:var(--accent);border:none;border-radius:14px 14px 0 0;
  white-space:nowrap;overflow:hidden;letter-spacing:0.02em
}
.L-tl-cmp .col-label.is-right{
  background:var(--primary);color:var(--on-accent)
}
.L-tl-cmp .vdiv{
  display:flex;align-items:center;justify-content:center;
  background:transparent;width:auto
}
.L-tl-cmp .vdiv::after{
  content:"VS";font-size:12pt;font-weight:800;letter-spacing:0.08em;
  color:var(--caption);width:36px;height:36px;border-radius:50%;
  background:var(--paper);box-shadow:0 2px 10px var(--shadow-soft);
  display:flex;align-items:center;justify-content:center
}
.L-tl-cmp .bullets{
  list-style:none;display:flex;flex-direction:column;gap:14px;margin:0;
  padding:20px 22px 22px;overflow:hidden;flex:1
}
.L-tl-cmp .bullets li{
  position:relative;padding-left:20px;font-size:{{ sc.item_pt }}pt;font-weight:400;color:var(--ink);
  line-height:1.4;overflow:hidden
}
.L-tl-cmp .bullets li::before{
  content:"";position:absolute;left:0;top:0.55em;width:8px;height:8px;border-radius:50%;
  background:var(--accent)
}
.L-tl-cmp .col.is-right .bullets li::before{background:var(--primary2)}
.L-tl-cmp .table-wrap{
  flex:1;display:flex;flex-direction:column;min-height:0;overflow:hidden;
  background:var(--paper);border-radius:14px;box-shadow:0 8px 28px var(--shadow-soft);padding:8px 8px 4px
}
.L-tl-cmp table{width:100%;border-collapse:collapse;table-layout:fixed}
.L-tl-cmp th{
  font-size:14pt;font-weight:700;color:var(--on-accent);text-align:left;
  padding:14px 18px;background:var(--accent);border:none
}
.L-tl-cmp th:first-child{border-radius:10px 0 0 0}
.L-tl-cmp th:last-child{background:var(--primary);border-radius:0 10px 0 0;color:var(--on-accent)}
.L-tl-cmp td{
  font-size:14.5pt;font-weight:400;color:var(--ink);padding:14px 18px;
  border-bottom:1px solid var(--line);vertical-align:top;line-height:1.4
}
.L-tl-cmp tr:nth-child(even) td{background:var(--surface2)}
.L-tl-cmp tr:last-child td{border-bottom:none}
.L-tl-cmp .takeaway{
  border:none;border-radius:10px;padding:14px 20px 14px 22px;
  font-size:15pt;font-weight:700;color:var(--primary);overflow:hidden;white-space:nowrap;
  background:var(--takeaway-bg);position:relative
}
.L-tl-cmp .takeaway::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--accent);border-radius:10px 0 0 10px
}
.L-tl-cmp .foot-page{
  position:absolute;left:{{ page.zones_px.footer_page.x }}px;top:{{ page.zones_px.footer_page.y }}px;
  width:{{ page.zones_px.footer_page.w }}px;height:{{ page.zones_px.footer_page.h }}px;
  font-size:11pt;font-weight:600;color:var(--caption)
}
.L-tl-cmp .foot-src{
  position:absolute;left:{{ page.zones_px.footer_source.x }}px;top:{{ page.zones_px.footer_source.y }}px;
  width:{{ page.zones_px.footer_source.w }}px;height:{{ page.zones_px.footer_source.h }}px;
  font-size:11pt;font-weight:400;color:var(--caption);text-align:right;overflow:hidden;white-space:nowrap
}
</style>
<section class="slide L-tl-cmp" id="{{ page.id }}" data-template="{{ page.template_id }}" data-family="comparison" data-variant="{{ page.variant }}" data-theme="{{ page.theme_name }}" data-pattern="C-two-column-contrast">
  {% if page.section %}<div class="section" data-slot="section">{{ page.section }}</div>{% endif %}
  <div class="headline" data-slot="title">{{ page.title }}</div>
  <div class="body-card" data-shape="body-card">
    {% if page.variant == "table_2n" %}
    <div class="table-wrap" data-slot="rows" data-count="{{ rows|length }}">
      <table>
        <thead>
          <tr>
            <th data-slot="left_label">{{ page.left_label }}</th>
            <th data-slot="right_label">{{ page.right_label }}</th>
          </tr>
        </thead>
        <tbody>
          {% for r in rows %}
          <tr data-row="{{ r.index }}">
            <td data-slot="left">{{ r.left }}</td>
            <td data-slot="right">{{ r.right }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="cols" data-slot="columns">
      <div class="col is-left" data-side="left">
        <div class="col-label" data-slot="left_label">{{ page.left_label }}</div>
        <ul class="bullets" data-check="fit" data-slot="left_items" data-count="{{ left|length }}">
          {% for it in left %}
          <li data-item="{{ it.index }}" data-slot="text">{{ it.text }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="vdiv" data-shape="column-divider" aria-hidden="true"></div>
      <div class="col is-right" data-side="right">
        <div class="col-label is-right" data-slot="right_label">{{ page.right_label }}</div>
        <ul class="bullets" data-check="fit" data-slot="right_items" data-count="{{ right|length }}">
          {% for it in right %}
          <li data-item="{{ it.index }}" data-slot="text">{{ it.text }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}
    {% if page.takeaway %}<div class="takeaway" data-slot="takeaway">{{ page.takeaway }}</div>{% endif %}
  </div>
  {% if page.page %}<div class="foot-page" data-slot="page" data-chrome>{{ page.page }}</div>{% endif %}
  {% if page.source %}<div class="foot-src" data-slot="source" data-chrome>{{ page.source }}</div>{% endif %}
</section>
