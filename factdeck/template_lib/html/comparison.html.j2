{# Comparison — Pattern C dual-column contrast (NOT pillar cards). Variants: dual_column | table_2n. #}
{% set left = page["left_items"] %}
{% set right = page["right_items"] %}
{% set rows = page["rows"] %}
<style>
.L-tl-cmp{background:var(--canvas)}
.L-tl-cmp .section{
  position:absolute;left:{{ page.zones_px.header.x }}px;top:{{ page.zones_px.header.y }}px;
  width:{{ page.zones_px.header.w }}px;height:{{ page.zones_px.header.h }}px;
  font-size:13pt;font-weight:600;color:var(--caption);letter-spacing:0.04em;
  white-space:nowrap;overflow:hidden
}
.L-tl-cmp .headline{
  position:absolute;left:{{ page.zones_px.headline.x }}px;top:{{ page.zones_px.headline.y }}px;
  width:{{ page.zones_px.headline.w }}px;height:{{ page.zones_px.headline.h }}px;
  font-size:32pt;font-weight:700;color:var(--headline);white-space:nowrap;overflow:hidden;
  display:flex;align-items:center
}
.L-tl-cmp .body-card{
  position:absolute;left:{{ page.zones_px.body_card.x }}px;top:{{ page.zones_px.body_card.y }}px;
  width:{{ page.zones_px.body_card.w }}px;height:{{ page.zones_px.body_card.h }}px;
  background:var(--paper);border:1px solid #D9D9D9;border-radius:12px;
  padding:28px 36px 24px;display:flex;flex-direction:column;gap:16px
}
.L-tl-cmp .cols{
  flex:1;display:grid;grid-template-columns:1fr 1px 1fr;gap:0 28px;min-height:0;align-items:stretch
}
.L-tl-cmp .col{display:flex;flex-direction:column;gap:14px;min-width:0;overflow:hidden}
.L-tl-cmp .col-label{
  font-size:18pt;font-weight:700;color:var(--accent);padding-bottom:8px;
  border-bottom:2px solid var(--accent);white-space:nowrap;overflow:hidden
}
.L-tl-cmp .col-label.is-right{color:var(--primary2);border-bottom-color:var(--primary2)}
.L-tl-cmp .vdiv{background:var(--line);width:1px;align-self:stretch}
.L-tl-cmp .bullets{list-style:none;display:flex;flex-direction:column;gap:12px;margin:0;padding:0;overflow:hidden}
.L-tl-cmp .bullets li{
  position:relative;padding-left:22px;font-size:16pt;font-weight:400;color:var(--ink);
  line-height:1.35;overflow:hidden
}
.L-tl-cmp .bullets li::before{
  content:"";position:absolute;left:0;top:0.55em;width:8px;height:8px;border-radius:50%;
  background:var(--accent)
}
.L-tl-cmp .col.is-right .bullets li::before{background:var(--primary2)}
.L-tl-cmp .table-wrap{flex:1;display:flex;flex-direction:column;min-height:0;overflow:hidden}
.L-tl-cmp table{width:100%;border-collapse:collapse;table-layout:fixed}
.L-tl-cmp th{
  font-size:15pt;font-weight:700;color:var(--headline);text-align:left;
  padding:10px 14px 12px;border-bottom:2px solid var(--accent)
}
.L-tl-cmp th:last-child{border-bottom-color:var(--primary2);color:var(--primary2)}
.L-tl-cmp td{
  font-size:15pt;font-weight:400;color:var(--ink);padding:12px 14px;
  border-bottom:1px solid #e7e7e7;vertical-align:top;line-height:1.35
}
.L-tl-cmp tr:last-child td{border-bottom:none}
.L-tl-cmp .takeaway{
  border:1.5px solid var(--primary);border-radius:10px;padding:12px 18px;
  font-size:15pt;font-weight:700;color:var(--primary);overflow:hidden;white-space:nowrap
}
.L-tl-cmp .foot-page{
  position:absolute;left:{{ page.zones_px.footer_page.x }}px;top:{{ page.zones_px.footer_page.y }}px;
  width:{{ page.zones_px.footer_page.w }}px;height:{{ page.zones_px.footer_page.h }}px;
  font-size:11pt;font-weight:500;color:var(--caption)
}
.L-tl-cmp .foot-src{
  position:absolute;left:{{ page.zones_px.footer_source.x }}px;top:{{ page.zones_px.footer_source.y }}px;
  width:{{ page.zones_px.footer_source.w }}px;height:{{ page.zones_px.footer_source.h }}px;
  font-size:12pt;font-weight:400;color:var(--caption);text-align:right;overflow:hidden;white-space:nowrap
}
</style>
<section class="slide L-tl-cmp" id="{{ page.id }}" data-template="{{ page.template_id }}" data-family="comparison" data-variant="{{ page.variant }}" data-theme="{{ page.theme_name }}" data-pattern="C-two-column-contrast">
  {% if page.section %}<div class="section" data-slot="section">{{ page.section }}</div>{% endif %}
  <div class="headline" data-slot="title">{{ page.title }}</div>
  <div class="body-card" data-shape="body-card">
    {% if page.variant == "table_2n" %}
    <div class="table-wrap" data-slot="rows" data-count="{{ rows|length }}">
      <table>
        <thead>
          <tr>
            <th data-slot="left_label">{{ page.left_label }}</th>
            <th data-slot="right_label">{{ page.right_label }}</th>
          </tr>
        </thead>
        <tbody>
          {% for r in rows %}
          <tr data-row="{{ r.index }}">
            <td data-slot="left">{{ r.left }}</td>
            <td data-slot="right">{{ r.right }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="cols" data-slot="columns">
      <div class="col is-left" data-side="left">
        <div class="col-label" data-slot="left_label">{{ page.left_label }}</div>
        <ul class="bullets" data-slot="left_items" data-count="{{ left|length }}">
          {% for it in left %}
          <li data-item="{{ it.index }}" data-slot="text">{{ it.text }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="vdiv" data-shape="column-divider" aria-hidden="true"></div>
      <div class="col is-right" data-side="right">
        <div class="col-label is-right" data-slot="right_label">{{ page.right_label }}</div>
        <ul class="bullets" data-slot="right_items" data-count="{{ right|length }}">
          {% for it in right %}
          <li data-item="{{ it.index }}" data-slot="text">{{ it.text }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}
    {% if page.takeaway %}<div class="takeaway" data-slot="takeaway">{{ page.takeaway }}</div>{% endif %}
  </div>
  {% if page.page %}<div class="foot-page" data-slot="page" data-chrome>{{ page.page }}</div>{% endif %}
  {% if page.source %}<div class="foot-src" data-slot="source" data-chrome>{{ page.source }}</div>{% endif %}
</section>
