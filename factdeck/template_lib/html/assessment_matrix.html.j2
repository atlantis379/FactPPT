{# GOLD ABE assessment matrix — dense 2×2 with E spanning top; not three cards. #}
<style>
.L-tl-abe{background:var(--canvas)}
.L-tl-abe .gbar{
  position:absolute;left:0;top:0;width:1280px;height:68px;
  background:var(--primary);display:flex;align-items:center;justify-content:space-between;
  padding:0 28px;z-index:2
}
.L-tl-abe .gbar .gtitle{
  font-size:20pt;font-weight:700;color:#fff;letter-spacing:-0.01em;
  white-space:nowrap;overflow:hidden;max-width:980px
}
.L-tl-abe .gbar .gfig{
  font-size:12pt;font-weight:600;color:var(--accent-on-dark);letter-spacing:0.04em;white-space:nowrap
}
.L-tl-abe .gaccent{
  position:absolute;left:0;top:68px;width:1280px;height:4px;background:var(--accent);z-index:2
}
.L-tl-abe .body{
  position:absolute;left:28px;top:88px;width:1224px;height:560px;
  display:flex;flex-direction:column;gap:8px
}
.L-tl-abe .takeaway{
  font-size:11.5pt;font-weight:600;color:var(--primary);padding:2px 0 4px;
  border-bottom:1px solid var(--line);flex:0 0 auto
}
.L-tl-abe .matrix-wrap{
  flex:1;min-height:0;display:grid;
  grid-template-columns:150px 1fr 1fr;
  grid-template-rows:36px 1fr 1fr;
  gap:0;border:1px solid var(--line);background:var(--paper)
}
.L-tl-abe .corner{background:var(--surface);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.L-tl-abe .xhead{
  display:flex;align-items:center;justify-content:center;text-align:center;
  font-size:11pt;font-weight:700;color:var(--ink);padding:4px 10px;
  background:var(--surface);border-right:1px solid var(--line);border-bottom:1px solid var(--line);
  line-height:1.25
}
.L-tl-abe .xhead:last-of-type{border-right:none}
.L-tl-abe .yhead{
  display:flex;align-items:center;justify-content:center;text-align:center;
  font-size:10pt;font-weight:700;color:var(--ink);padding:10px 8px;
  background:var(--surface2);border-right:1px solid var(--line);border-bottom:1px solid var(--line);
  writing-mode:horizontal-tb;line-height:1.35;white-space:pre-line
}
.L-tl-abe .cell{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:16px 18px;gap:8px;
  border-right:1px solid var(--line);border-bottom:1px solid var(--line);
  min-height:0
}
.L-tl-abe .cell:nth-child(3n){border-right:none}
.L-tl-abe .cell.e{
  grid-column:2 / 4;background:var(--group-e,#D9E2EC);
  border-bottom:1px solid var(--line)
}
.L-tl-abe .cell.a{background:var(--group-a,#F0F0F0)}
.L-tl-abe .cell.b{background:var(--group-b,#E4E4E4)}
.L-tl-abe .glabel{
  display:inline-block;font-size:13pt;font-weight:800;color:var(--primary);
  letter-spacing:0.06em;padding:2px 10px;border:2px solid var(--primary);border-radius:2px;
  background:rgba(255,255,255,0.65)
}
.L-tl-abe .grx{font-size:16pt;font-weight:700;color:var(--ink);line-height:1.2}
.L-tl-abe .gnote{
  font-size:10.5pt;font-weight:600;color:var(--primary);line-height:1.35;max-width:92%;
  padding:4px 8px;background:rgba(255,255,255,0.55);border-left:3px solid var(--accent)
}
.L-tl-abe .axis-hint{
  flex:0 0 auto;display:flex;justify-content:space-between;gap:24px;
  font-size:9.5pt;color:var(--muted);padding:2px 4px 0
}
.L-tl-abe .axis-hint strong{color:var(--primary);font-weight:700}
.L-tl-abe .fn{
  flex:0 0 auto;font-size:9pt;color:var(--caption);line-height:1.35;padding-top:2px
}
.L-tl-abe .foot{
  position:absolute;left:28px;bottom:14px;right:28px;
  display:flex;justify-content:space-between;align-items:flex-end;gap:16px
}
.L-tl-abe .src{font-size:9pt;color:var(--caption);line-height:1.3;max-width:1000px}
.L-tl-abe .pg{font-size:10pt;font-weight:600;color:var(--muted)}
</style>
<div class="slide L-tl-abe" id="{{ page.id }}" data-family="assessment_matrix"
     data-variant="{{ page.variant }}" data-theme="{{ page.theme_name }}"
     data-pattern="GOLD-ABE-matrix" data-library="factdeck.template_lib.v1">
  <div class="gbar">
    <div class="gtitle" data-slot="title">{{ page.title }}</div>
    {% if page.figure %}<div class="gfig" data-slot="figure">{{ page.figure }}</div>{% endif %}
  </div>
  <div class="gaccent" data-shape="gold-accent"></div>
  <div class="body">
    {% if page.takeaway %}<div class="takeaway" data-slot="takeaway">{{ page.takeaway }}</div>{% endif %}
    <div class="matrix-wrap" data-slot="matrix" data-shape="abe-matrix">
      <div class="corner"></div>
      <div class="xhead" data-slot="x_left">{{ page.x_left }}</div>
      <div class="xhead" data-slot="x_right">{{ page.x_right }}</div>
      <div class="yhead" data-slot="y_top">{{ page.y_top }}</div>
      <div class="cell e" data-shape="group-e">
        <div class="glabel" data-slot="e_label">{{ page.e_label }}</div>
        <div class="grx" data-slot="e_rx">{{ page.e_rx }}</div>
        {% if page.e_note %}<div class="gnote" data-slot="e_note">{{ page.e_note }}</div>{% endif %}
      </div>
      <div class="yhead" data-slot="y_bottom">{{ page.y_bottom }}</div>
      <div class="cell a" data-shape="group-a">
        <div class="glabel" data-slot="a_label">{{ page.a_label }}</div>
        <div class="grx" data-slot="a_rx">{{ page.a_rx }}</div>
        {% if page.a_note %}<div class="gnote" data-slot="a_note">{{ page.a_note }}</div>{% endif %}
      </div>
      <div class="cell b" data-shape="group-b">
        <div class="glabel" data-slot="b_label">{{ page.b_label }}</div>
        <div class="grx" data-slot="b_rx">{{ page.b_rx }}</div>
        {% if page.b_note %}<div class="gnote" data-slot="b_note">{{ page.b_note }}</div>{% endif %}
      </div>
    </div>
    {% if page.x_hint or page.y_hint %}
    <div class="axis-hint">
      {% if page.x_hint %}<div><strong>横轴</strong> <span data-slot="x_hint">{{ page.x_hint }}</span></div>{% endif %}
      {% if page.y_hint %}<div><strong>纵轴</strong> <span data-slot="y_hint">{{ page.y_hint }}</span></div>{% endif %}
    </div>
    {% endif %}
    {% if page.footnote %}<div class="fn" data-slot="footnote">{{ page.footnote }}</div>{% endif %}
  </div>
  <div class="foot">
    <div class="src" data-slot="source">{{ page.source }}</div>
    {% if page.page %}<div class="pg" data-slot="page">{{ page.page }}</div>{% endif %}
  </div>
</div>
