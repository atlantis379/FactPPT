{# Process flow — continuous pathway rail + filled nodes; not SmartArt outline boxes. #}
{% set nodes = page["nodes"] %}
{% set n = nodes|length %}
{% set orient = page.get("orientation") or "horizontal" %}
<style>
.L-tl-flow{background:var(--canvas)}
.L-tl-flow .section{
  position:absolute;left:{{ page.zones_px.header.x }}px;top:{{ page.zones_px.header.y }}px;
  width:{{ page.zones_px.header.w }}px;height:{{ page.zones_px.header.h }}px;
  font-size:12pt;font-weight:600;color:var(--caption);letter-spacing:0.12em;
  white-space:nowrap;overflow:hidden;text-transform:uppercase
}
.L-tl-flow .headline{
  position:absolute;left:{{ page.zones_px.headline.x }}px;top:{{ page.zones_px.headline.y }}px;
  width:{{ page.zones_px.headline.w }}px;height:{{ page.zones_px.headline.h }}px;
  font-size:30pt;font-weight:700;color:var(--headline);white-space:nowrap;overflow:hidden;
  display:flex;align-items:center;letter-spacing:-0.02em
}
.L-tl-flow .body-card{
  position:absolute;left:{{ page.zones_px.body_card.x }}px;top:{{ page.zones_px.body_card.y }}px;
  width:{{ page.zones_px.body_card.w }}px;height:{{ page.zones_px.body_card.h }}px;
  background:transparent;border:none;border-radius:0;padding:8px 4px 4px;
  display:flex;flex-direction:column;gap:18px
}
.L-tl-flow .track{
  flex:1;display:flex;align-items:stretch;justify-content:center;gap:0;min-height:0;overflow:hidden;
  position:relative;padding:12px 8px
}
.L-tl-flow .track.is-horizontal{flex-direction:row;align-items:center}
.L-tl-flow .track.is-vertical{flex-direction:column;align-items:stretch;padding:8px 12%}
.L-tl-flow .track.is-horizontal::before{
  content:"";position:absolute;left:6%;right:6%;top:50%;
  background:linear-gradient(90deg,var(--accent) 0%,var(--accent2) 100%);
  border-radius:3px;transform:translateY(-50%);z-index:0;opacity:0.55;height:6px
}
.L-tl-flow .track.is-vertical::before{
  content:"";position:absolute;left:50%;top:4%;bottom:4%;width:4px;
  background:linear-gradient(180deg,var(--accent) 0%,var(--accent2) 100%);
  border-radius:2px;transform:translateX(-50%);z-index:0;opacity:0.35
}
.L-tl-flow .node{
  flex:1;min-width:0;border:none;border-radius:14px;background:var(--paper);
  box-shadow:0 8px 24px var(--shadow-soft);
  padding:18px 14px;display:flex;flex-direction:column;align-items:center;text-align:center;
  gap:10px;overflow:hidden;position:relative;z-index:1
}
.L-tl-flow .node.is-first{
  background:linear-gradient(165deg,var(--primary) 0%,var(--accent) 100%);
  box-shadow:0 10px 28px var(--shadow)
}
.L-tl-flow .track.is-vertical .node{flex-direction:row;text-align:left;align-items:flex-start;gap:16px;padding:16px 20px}
.L-tl-flow .node .num{
  width:36px;height:36px;border-radius:50%;border:none;color:var(--on-accent);
  font-size:14pt;font-weight:700;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;background:var(--accent);box-shadow:0 2px 8px var(--shadow-soft)
}
.L-tl-flow .node.is-first .num{background:rgba(255,255,255,0.22);color:#fff}
.L-tl-flow .node .meta{display:flex;flex-direction:column;gap:4px;min-width:0;overflow:hidden;
  {% if orient == "horizontal" %}align-items:center{% else %}align-items:flex-start;flex:1{% endif %}
}
.L-tl-flow .node .tag{
  font-size:11pt;font-weight:700;color:var(--accent);letter-spacing:0.12em;text-transform:uppercase;
  white-space:nowrap;overflow:hidden;max-width:100%
}
.L-tl-flow .node.is-first .tag{color:var(--accent-on-dark)}
.L-tl-flow .node .heading{
  font-size:{% if n >= 6 %}13.5pt{% else %}15.5pt{% endif %};font-weight:700;color:var(--ink);
  line-height:1.2;overflow:hidden;max-width:100%
}
.L-tl-flow .node.is-first .heading{color:#fff}
.L-tl-flow .node .body{
  font-size:12.5pt;font-weight:400;color:var(--muted);line-height:1.35;overflow:hidden;max-width:100%
}
.L-tl-flow .node.is-first .body{color:rgba(255,255,255,0.85)}
.L-tl-flow .arrow{
  flex:0 0 28px;display:flex;align-items:center;justify-content:center;color:var(--accent);
  position:relative;z-index:2;user-select:none
}
.L-tl-flow .arrow svg{width:22px;height:22px;display:block}
.L-tl-flow .track.is-vertical .arrow{flex:0 0 22px}
.L-tl-flow .track.is-vertical .arrow svg{transform:rotate(90deg)}
.L-tl-flow .takeaway{
  border:none;border-radius:10px;padding:14px 20px 14px 22px;
  font-size:15pt;font-weight:700;color:var(--primary);overflow:hidden;white-space:nowrap;
  background:var(--takeaway-bg);position:relative
}
.L-tl-flow .takeaway::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--accent);border-radius:10px 0 0 10px
}
.L-tl-flow .foot-page{
  position:absolute;left:{{ page.zones_px.footer_page.x }}px;top:{{ page.zones_px.footer_page.y }}px;
  width:{{ page.zones_px.footer_page.w }}px;height:{{ page.zones_px.footer_page.h }}px;
  font-size:11pt;font-weight:600;color:var(--caption)
}
.L-tl-flow .foot-src{
  position:absolute;left:{{ page.zones_px.footer_source.x }}px;top:{{ page.zones_px.footer_source.y }}px;
  width:{{ page.zones_px.footer_source.w }}px;height:{{ page.zones_px.footer_source.h }}px;
  font-size:11pt;font-weight:400;color:var(--caption);text-align:right;overflow:hidden;white-space:nowrap
}
</style>
<section class="slide L-tl-flow" id="{{ page.id }}" data-template="{{ page.template_id }}" data-family="flow" data-variant="{{ page.variant }}" data-theme="{{ page.theme_name }}" data-pattern="K-process-flow" data-orientation="{{ orient }}">
  {% if page.section %}<div class="section" data-slot="section">{{ page.section }}</div>{% endif %}
  <div class="headline" data-slot="title">{{ page.title }}</div>
  <div class="body-card" data-shape="body-card">
    <div class="track is-{{ orient }}" data-slot="nodes" data-count="{{ n }}">
      {% for it in nodes %}
      {% if not loop.first %}
      <div class="arrow" data-shape="connector" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h11M12 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      {% endif %}
      <div class="node{% if loop.first %} is-first{% endif %}" data-item="{{ it.index }}">
        <div class="num" data-slot="index">{{ it.index }}</div>
        <div class="meta">
          {% if it.tag %}<div class="tag" data-slot="tag">{{ it.tag }}</div>{% endif %}
          <div class="heading" data-slot="heading">{{ it.heading }}</div>
          {% if it.body %}<div class="body" data-slot="body">{{ it.body }}</div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% if page.takeaway %}<div class="takeaway" data-slot="takeaway">{{ page.takeaway }}</div>{% endif %}
  </div>
  {% if page.page %}<div class="foot-page" data-slot="page" data-chrome>{{ page.page }}</div>{% endif %}
  {% if page.source %}<div class="foot-src" data-slot="source" data-chrome>{{ page.source }}</div>{% endif %}
</section>
