{# Shared chrome for pharma / congress chart-led families (gold_clinical tokens). #}
.ph{background:#FFFFFF}
.ph .hbar{position:absolute;left:0;top:0;width:1280px;height:68px;background:var(--primary);
  display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 28px}
.ph .htitle{font-size:19pt;font-weight:700;color:#FFFFFF;line-height:1.3;min-width:0;letter-spacing:-0.01em}
.ph .hfig{font-size:11.5pt;font-weight:600;color:var(--accent-on-dark);white-space:nowrap;letter-spacing:0.04em}
.ph .hacc{position:absolute;left:0;top:68px;width:1280px;height:4px;background:var(--accent)}
.ph .sub{position:absolute;left:28px;top:79px;width:1224px;height:24px;font-size:11pt;color:var(--muted);
  white-space:nowrap;line-height:24px}
.ph .sub .sec{color:var(--primary);font-weight:700;margin-right:10px}
.ph .main{position:absolute;left:28px;top:112px;width:896px;height:512px}
.ph .main.full{width:1224px}
.ph .rail{position:absolute;left:942px;top:112px;width:310px;height:512px;
  border-left:1px solid var(--line);padding-left:18px;display:flex;flex-direction:column}
.ph .rail-h{font-size:10pt;font-weight:700;color:var(--primary);letter-spacing:0.08em;
  padding-bottom:5px;border-bottom:2px solid var(--primary)}
.ph .tk{padding:11px 0 11px;border-bottom:1px solid var(--line)}
.ph .tk:last-child{border-bottom:none}
.ph .tk .v{font-size:20pt;font-weight:700;color:var(--primary);line-height:1.1;font-variant-numeric:tabular-nums;white-space:nowrap}
.ph .tk .v small{font-size:10pt;font-weight:600;color:var(--muted);margin-left:4px}
.ph .tk .t{font-size:10.5pt;line-height:1.42;color:var(--ink);margin-top:4px}
.ph sup.ev{font-size:7pt;line-height:0;color:var(--primary);font-weight:700;margin-left:1px}
.ph .foot{position:absolute;left:28px;width:1224px;top:634px;height:78px;border-top:1px solid var(--line);
  padding-top:5px;font-size:8.5pt;line-height:1.36;color:var(--caption);display:flex;flex-direction:column;justify-content:flex-start}
.ph .foot .row{white-space:nowrap}
.ph .foot b{color:var(--muted);font-weight:700;margin-right:4px}
.ph .foot .last{display:flex;justify-content:space-between;align-items:baseline;gap:16px}
.ph .foot .last .dn{color:var(--muted)}
.ph .foot .pg{font-size:10pt;font-weight:600;color:var(--muted)}
.ph svg{display:block;overflow:visible;font-family:var(--font)}
.ph svg text{fill:var(--ink)}
.ph svg .t-mut{fill:var(--muted)}
.ph svg .t-cap{fill:var(--caption)}
.ph svg .t-pri{fill:var(--primary)}
.ph svg .t-wht{fill:#FFFFFF}
.ph svg .t-b{font-weight:700}
.ph svg .ln-ax{stroke:#555555;stroke-width:1;fill:none}
.ph svg .ln-grid{stroke:#E3E3E3;stroke-width:1;fill:none}
.ph svg .ln-hair{stroke:var(--line);stroke-width:1;fill:none}
.ph svg .ln-ink{stroke:var(--ink);stroke-width:1.2;fill:none}
.ph svg .ln-pri{stroke:var(--primary);stroke-width:1.5;fill:none}
.ph svg .ln-acc{stroke:var(--accent);stroke-width:1.6;fill:none}
.ph svg .f-pri{fill:var(--primary)}
.ph svg .f-ctl{fill:#BDBDBD}
.ph svg .f-grey{fill:var(--surface)}
.ph svg .f-zebra{fill:#F6F6F6}
.ph svg .f-hl{fill:var(--takeaway-bg);stroke:var(--accent);stroke-width:2}
