{# Every visible string is one of: a fact (data-fact), model-authored text that passed
   the lint (data-authored), or generated chrome (data-chrome). Text containers that
   become PowerPoint text boxes carry data-t. Anything else is reported as untracked.
   Layout sizes inside the body scale with --k so the renderer can tighten a dense
   page without changing its structure. #}
{%- macro fact(ref, cls="") -%}
{%- set f = facts[ref.fact] -%}
<span class="f {{ cls }}{% if f.conflict %} conflict{% endif %}" data-fact="{{ f.id }}">{{ f.text }}</span>
{%- if f.pending %}<span class="mark" data-mark="pending" title="待人工确认">●</span>{% endif -%}
{%- endmacro -%}
{%- macro node(ref) -%}{% if ref is mapping and ref.fact is defined %}{{ fact(ref) }}{% elif ref is mapping %}<span data-authored>{{ ref.text }}</span>{% endif %}{%- endmacro -%}
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{{ deck.title }}</title>
<style>
:root{
{%- for k, v in theme.items() %}  --{{ k }}:{{ v }};
{% endfor -%}
  --paper:#FFFFFF; --red:#C0392B; --amber:#D08A00;
  --font:"Microsoft YaHei","微软雅黑","Noto Sans CJK SC","Noto Sans SC","PingFang SC",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:#E9EDF2;font-family:var(--font);color:var(--ink)}
.slide{--k:1;position:relative;width:1280px;height:720px;overflow:hidden;background:var(--paper);margin:0 auto 24px;-webkit-font-smoothing:antialiased}
@media print{html,body{background:none}.slide{margin:0;page-break-after:always}}
@page{size:1280px 720px;margin:0}
/* chrome */
.head{position:absolute;left:64px;top:40px;right:64px}
.section{font-size:14px;font-weight:700;letter-spacing:.12em;color:var(--accent);height:20px;line-height:20px;white-space:nowrap;overflow:hidden}
.title{margin-top:8px;font-size:calc(var(--k)*34px);font-weight:700;line-height:46px;color:var(--primary);height:46px;white-space:nowrap}
.lead{margin-top:8px;font-size:calc(var(--k)*17px);line-height:calc(var(--k)*26px);color:var(--muted);height:54px}
.accent-bar{position:absolute;left:0;top:60px;width:8px;height:52px;background:var(--accent)}
.foot{position:absolute;left:64px;right:64px;bottom:20px;height:36px;border-top:1px solid var(--line)}
.foot .src{position:absolute;left:0;top:7px;right:110px;font-size:10.5px;line-height:15px;color:var(--muted);height:30px;overflow:hidden}
.foot .pg{position:absolute;right:0;top:7px;width:100px;text-align:right;font-size:12px;line-height:16px;color:var(--muted);font-weight:700}
.legend{color:var(--amber);font-weight:700}
.mark{color:#E0A526;font-size:.5em;margin-left:3px;vertical-align:.6em;opacity:.85}
.f.conflict{color:var(--red)}
.tag-conflict{display:inline-block;margin-left:6px;padding:0 6px;border-radius:4px;background:#FBE9E7;color:var(--red);font-size:11px;line-height:18px;font-weight:700}
.body{position:absolute;left:64px;right:64px;top:{{ 196 }}px;bottom:72px}
/* cover / divider / closing */
.L-cover,.L-divider{background:var(--primary)}
.L-cover .art,.L-divider .art{position:absolute;right:0;top:0;width:640px;height:720px}
.L-cover .k{position:absolute;left:88px;top:196px;width:600px;height:24px;font-size:16px;line-height:24px;letter-spacing:.2em;color:var(--accent-on-dark);font-weight:700;white-space:nowrap;overflow:hidden}
.L-cover .t{position:absolute;left:88px;top:236px;width:640px;height:164px;font-size:calc(var(--k)*54px);line-height:calc(var(--k)*76px);font-weight:900;color:#fff}
.L-cover .bar,.L-divider .bar{position:absolute;left:88px;top:410px;width:72px;height:4px;background:var(--accent2)}
.L-cover .s{position:absolute;left:88px;top:430px;width:640px;height:68px;font-size:calc(var(--k)*22px);line-height:34px;color:#D5DFEC}
.L-cover .meta{position:absolute;left:88px;bottom:56px;width:640px;height:20px;font-size:13px;line-height:20px;color:#9FB0C8}
.L-divider .t{position:absolute;left:88px;top:270px;width:680px;height:120px;font-size:calc(var(--k)*46px);line-height:calc(var(--k)*60px);font-weight:900;color:#fff}
.L-divider .s{position:absolute;left:88px;top:430px;width:640px;height:68px;font-size:calc(var(--k)*20px);line-height:32px;color:#D5DFEC}
.L-divider .no{position:absolute;left:88px;top:212px;width:200px;height:40px;font-size:30px;line-height:40px;font-weight:900;color:var(--accent-on-dark)}
/* bullets */
.items{list-style:none;column-gap:48px}
.items.two{column-count:2}
.items li{position:relative;padding-left:24px;font-size:calc(var(--k)*20px);line-height:calc(var(--k)*31px);color:var(--ink);margin-bottom:calc(var(--k)*16px);break-inside:avoid}
.items li:before{content:"";position:absolute;left:2px;top:calc(var(--k)*11px);width:9px;height:9px;border-radius:2px;background:var(--accent)}
.items.two li{font-size:calc(var(--k)*18px);line-height:calc(var(--k)*28px)}
.items.big li{font-size:calc(var(--k)*24px);line-height:calc(var(--k)*36px);padding:calc(var(--k)*20px) 0 calc(var(--k)*20px) 34px;margin:0;border-bottom:1px solid var(--line)}
.items.big li:first-child{border-top:1px solid var(--line)}
.items.big li:before{left:4px;top:calc(var(--k)*34px);width:12px;height:12px;border-radius:3px}
/* table */
.tbl{border-collapse:collapse;width:1152px;table-layout:fixed}
.tbl th{background:var(--primary);color:#fff;font-size:calc(var(--k)*15px);line-height:calc(var(--k)*21px);font-weight:700;text-align:left;padding:calc(var(--k)*11px) 14px}
.tbl td{font-size:calc(var(--k)*16px);line-height:calc(var(--k)*23px);padding:calc(var(--k)*11px) 14px;border-bottom:1px solid var(--line);vertical-align:top;color:var(--ink)}
.tbl tr:nth-child(even) td{background:var(--sky)}
.tbl td:first-child{font-weight:700;color:var(--primary)}
.tbl .cellline{display:block}
/* cards */
.cards{display:flex;gap:20px;height:calc(var(--k)*190px)}
.card{flex:1;background:var(--paper);border:1px solid var(--line);border-top:5px solid var(--accent);border-radius:10px;padding:18px 22px;position:relative;overflow:hidden}
.card .lb{font-size:calc(var(--k)*15px);line-height:calc(var(--k)*22px);color:var(--muted);height:calc(var(--k)*44px);overflow:hidden}
.card .vl{margin-top:10px;font-size:calc(var(--k)*40px);line-height:calc(var(--k)*52px);font-weight:800;color:var(--primary)}
.card .vl.word{font-size:calc(var(--k)*24px);line-height:calc(var(--k)*34px)}
.card .nt{margin-top:6px;font-size:calc(var(--k)*13.5px);line-height:calc(var(--k)*20px);color:var(--muted)}
.cardnotes{margin-top:24px;background:var(--soft);border-radius:10px;padding:16px 24px}
.cardnotes .h,.panel .h,.side .h{font-size:13px;line-height:18px;font-weight:700;color:var(--accent);letter-spacing:.1em;height:18px;margin-bottom:6px}
.cardnotes li{list-style:none;position:relative;padding-left:18px;font-size:calc(var(--k)*15.5px);line-height:calc(var(--k)*24px);margin-bottom:6px}
.cardnotes li:before{content:"";position:absolute;left:0;top:calc(var(--k)*9px);width:7px;height:7px;border-radius:50%;background:var(--accent)}
/* compare */
.panels{display:flex;gap:24px;align-items:stretch;max-height:calc(100% - var(--band, 0px))}
.panel{flex:1;border:1px solid var(--line);border-top:5px solid var(--primary2);border-radius:12px;padding:18px 24px;position:relative;overflow:hidden}
.panel .st{font-size:calc(var(--k)*19px);line-height:calc(var(--k)*27px);font-weight:700;color:var(--primary)}
.panel .big{margin-top:12px;font-size:calc(var(--k)*52px);line-height:calc(var(--k)*64px);font-weight:900;color:var(--accent)}
.panel .bl{font-size:calc(var(--k)*15px);line-height:calc(var(--k)*22px);color:var(--muted);margin-bottom:12px}
.panel .ci{font-size:calc(var(--k)*15.5px);line-height:calc(var(--k)*23px);color:var(--ink);padding:calc(var(--k)*7px) 0 calc(var(--k)*7px) 22px;border-bottom:1px dashed var(--line);position:relative}
.panel .ci:before{content:"";position:absolute;left:2px;top:calc(var(--k)*14px);width:9px;height:9px;border-radius:2px;background:var(--accent)}
.band{position:relative;margin-top:20px;min-height:64px;background:var(--primary);border-radius:10px;padding:14px 26px;color:#fff;overflow:hidden}
.band .b1{font-size:calc(var(--k)*17px);line-height:calc(var(--k)*26px);font-weight:700}
.band .b2{font-size:calc(var(--k)*14px);line-height:calc(var(--k)*22px);color:#C9D6E8;margin-top:4px}
/* flow */
.canvas{position:absolute;left:0;top:0}
.node{position:absolute;border-radius:9px;background:var(--paper);border:1.5px solid var(--primary2);display:flex;align-items:center;justify-content:center;text-align:center;
  font-size:calc(var(--k)*15px);line-height:calc(var(--k)*20px);font-weight:700;color:var(--primary);padding:4px 8px;overflow:hidden}
.node.core{background:var(--primary);color:#fff;border-color:var(--primary)}
.node.soft{background:var(--sky);border-color:var(--line);color:var(--ink);font-weight:500}
.edges{position:absolute;left:0;top:0;overflow:visible}
.tag{position:absolute;transform:translateX(-50%);height:24px;border-radius:12px;background:var(--accent);color:#fff;font-size:calc(var(--k)*12.5px);line-height:24px;font-weight:700;text-align:center;white-space:nowrap;overflow:hidden;padding:0 8px}
.side{position:absolute;right:0;top:0;width:{{ 300 }}px;bottom:0}
.side .p{font-size:calc(var(--k)*14.5px);line-height:calc(var(--k)*22px);color:var(--ink);padding:12px 16px;border-left:4px solid var(--accent);background:var(--sky);border-radius:0 8px 8px 0;margin-bottom:12px}
/* statement */
.stmt{position:absolute;left:40px;right:40px;top:10px;height:210px;display:flex;align-items:center;font-size:calc(var(--k)*30px);line-height:calc(var(--k)*46px);font-weight:700;color:var(--primary);
  border-left:6px solid var(--accent);padding-left:36px}
.support{position:absolute;left:40px;right:40px;top:250px}
.support li{list-style:none;position:relative;padding-left:22px;font-size:calc(var(--k)*17px);line-height:calc(var(--k)*27px);color:var(--ink);margin-bottom:12px}
/* figure: a source picture, whole and unaltered, with its caption and source */
.figwrap{position:absolute;left:0;top:0}
.figbox{display:flex;align-items:center;justify-content:center}
.figbox img{display:block;object-fit:contain}
.figcap{margin-top:8px;height:44px;font-size:calc(var(--k)*14.5px);line-height:calc(var(--k)*22px);color:var(--ink);text-align:center;overflow:hidden}
.figsrc{height:20px;margin-top:6px;font-size:12px;line-height:20px;color:var(--muted);text-align:center;white-space:nowrap;overflow:hidden}
.support li:before{content:"";position:absolute;left:2px;top:calc(var(--k)*10px);width:8px;height:8px;border-radius:50%;background:var(--accent)}
</style>
</head>
<body>
{% for p in pages %}
<section class="slide L-{{ p.layout }}" id="{{ p.id }}" data-slide="{{ loop.index }}">
{% if p.layout in ("cover", "divider") %}
  <svg class="art" data-raster="art-{{ p.id }}" viewBox="0 0 640 720" aria-hidden="true">
    <defs>
      <linearGradient id="g1-{{ p.id }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" style="stop-color:var(--accent2)" stop-opacity=".95"/><stop offset="1" style="stop-color:var(--primary2)" stop-opacity=".25"/></linearGradient>
      <radialGradient id="g2-{{ p.id }}" cx=".7" cy=".45" r=".7"><stop offset="0" style="stop-color:var(--primary2)" stop-opacity=".9"/><stop offset="1" style="stop-color:var(--primary)" stop-opacity="0"/></radialGradient>
    </defs>
    <rect width="640" height="720" fill="url(#g2-{{ p.id }})"/>
    <g fill="none" stroke="url(#g1-{{ p.id }})" stroke-linecap="round">
      {% for b in p.art.branches %}<path d="{{ b.d }}" stroke-width="{{ b.w }}" opacity="{{ b.o }}"/>{% endfor %}
    </g>
    <g style="fill:var(--accent-on-dark)">{% for d in p.art.dots %}<circle cx="{{ d.x }}" cy="{{ d.y }}" r="{{ d.r }}" opacity="{{ d.o }}"/>{% endfor %}</g>
  </svg>
  {% if p.layout == "cover" %}
  {% if p.kicker %}<div class="k" data-t>{{ node(p.kicker) }}</div>{% endif %}
  <div class="t" data-t>{{ node(p.title) }}</div>
  <div class="bar" data-shape></div>
  {% if p.subtitle %}<div class="s" data-t>{{ node(p.subtitle) }}</div>{% endif %}
  <div class="meta" data-t data-chrome>{{ p.chrome_meta }}</div>
  {% else %}
  <div class="no" data-t data-chrome>{{ "%02d"|format(p.divider_no) }}</div>
  <div class="t" data-t>{{ node(p.title) }}</div>
  <div class="bar" data-shape></div>
  {% if p.subtitle %}<div class="s" data-t>{{ node(p.subtitle) }}</div>{% endif %}
  {% endif %}
{% else %}
  <div class="accent-bar" data-shape></div>
  <div class="head">
    {% if p.section %}<div class="section" data-t>{{ node(p.section) }}</div>{% else %}<div class="section"></div>{% endif %}
    <div class="title" data-t>{{ node(p.title) }}</div>
    {% if p.lead %}<div class="lead" data-t>{{ node(p.lead) }}</div>{% endif %}
  </div>
  <div class="body"{% if not p.lead %} style="top:150px"{% endif %}>
  {% if p.layout == "bullets" or p.layout == "closing" %}
    {% set n_items = (p['items'] or [])|length %}<ul class="items{% if n_items > 5 %} two{% elif n_items <= 4 %} big{% endif %}">{% for it in p['items'] or [] %}<li data-t>{{ node(it) }}</li>{% endfor %}</ul>
  {% elif p.layout == "table" %}
  <table class="tbl" data-table>
    <colgroup>{% for w in p.col_widths %}<col style="width:{{ w }}%">{% endfor %}</colgroup>
    <tr>{% for c in p.columns %}<th data-authored>{{ c if c is string else c.text }}</th>{% endfor %}</tr>
    {% for row in p.rows %}<tr>{% for cell in row %}<td>{% for ref in cell %}<span class="cellline">{{ node(ref) }}{% if ref.fact is defined and facts[ref.fact].conflict and loop.last %}<span class="tag-conflict" data-chrome>来源不一致</span>{% endif %}</span>{% endfor %}</td>{% endfor %}</tr>{% endfor %}
  </table>
  {% elif p.layout == "cards" %}
  <div class="cards">
    {% for c in p.cards %}<div class="card" data-shape>
      {% if c.label %}<div class="lb" data-t>{{ node(c.label) }}</div>{% endif %}
      <div class="vl{% if not c.numeric %} word{% endif %}" data-t>{{ node(c.value) }}</div>
      {% if c.note %}<div class="nt" data-t>{{ node(c.note) }}</div>{% endif %}
    </div>{% endfor %}
  </div>
  {% if p.notes %}<div class="cardnotes" data-shape>
    {% if p.notes_title %}<div class="h" data-t>{{ node(p.notes_title) }}</div>{% endif %}
    <ul>{% for n in p.notes %}<li data-t>{{ node(n) }}</li>{% endfor %}</ul>
  </div>{% endif %}
  {% elif p.layout == "compare" %}
  <div class="panels" style="--band:{{ 104 if p.band else 0 }}px">
    {% for pn in p.panels %}<div class="panel" data-shape>
      <div class="st" data-t>{{ node(pn.heading) }}</div>
      {% if pn.value %}<div class="big" data-t>{{ node(pn.value) }}</div>{% endif %}
      {% if pn.value_label %}<div class="bl" data-t>{{ node(pn.value_label) }}</div>{% endif %}
      {% for c in pn['items'] or [] %}<div class="ci" data-t>{{ node(c) }}</div>{% endfor %}
    </div>{% endfor %}
  </div>
  {% if p.band %}<div class="band" data-shape>
    <div class="b1" data-t>{{ node(p.band[0]) }}</div>
    {% if p.band|length > 1 %}<div class="b2" data-t>{{ node(p.band[1]) }}</div>{% endif %}
  </div>{% endif %}
  {% elif p.layout == "flow" %}
  <div class="canvas" style="width:{{ p.geo.w }}px;height:{{ p.geo.h }}px">
    <svg class="edges" data-edges viewBox="0 0 {{ p.geo.w }} {{ p.geo.h }}" width="{{ p.geo.w }}" height="{{ p.geo.h }}">
      <defs><marker id="arr-{{ p.id }}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--primary2)"/></marker></defs>
      {% for e in p.geo.edges %}<polyline data-edge="{{ e.support }}" points="{{ e.points }}" fill="none" style="stroke:var(--primary2)" stroke-width="2" marker-end="url(#arr-{{ p.id }})"/>{% endfor %}
    </svg>
    {% for n in p.geo.nodes %}
    <div class="node {{ n.cls }}" style="left:{{ n.x }}px;top:{{ n.y }}px;width:{{ n.w }}px;height:{{ n.h }}px" data-shape data-t>{{ node(n.ref) }}</div>
    {% if n.tag %}<div class="tag" style="left:{{ n.x + n.w / 2 }}px;top:{{ n.tag_y }}px;min-width:{{ n.w }}px;max-width:{{ n.w + p.geo.gap_x - 8 }}px" data-shape data-t>{{ node(n.tag) }}</div>{% endif %}
    {% endfor %}
  </div>
  {% if p.side %}<div class="side">{% for x in p.side %}<div class="p" data-shape data-t>{{ node(x) }}</div>{% endfor %}</div>{% endif %}
  {% elif p.layout == "figure" %}
  <div class="figwrap" style="width:{{ p.fig.box_w }}px;top:{{ p.fig.top }}px">
    <div class="figbox" style="height:{{ p.fig.h }}px"><img data-figure="{{ p.fig.fact }}" src="{{ p.fig.file }}" alt=""
      style="width:{{ p.fig.w }}px;height:{{ p.fig.h }}px"></div>
    {% if p.fig.caption %}<div class="figcap" data-t>{% for c in p.fig.caption %}{{ fact({"fact": c}) }}{% if not loop.last %} {% endif %}{% endfor %}</div>{% endif %}
    <div class="figsrc" data-t data-chrome>图源：{{ p.fig.source }}（原件图片，未作修改）{% if p.fig.pending %}<span class="legend"> ● 待确认</span>{% endif %}</div>
  </div>
  {% if p.side %}<div class="side">{% for x in p.side %}<div class="p" data-shape data-t>{{ node(x) }}</div>{% endfor %}</div>{% endif %}
  {% elif p.layout == "statement" %}
  <div class="stmt" data-shape data-t>{{ node(p.statement) }}</div>
  {% if p.support %}<ul class="support">{% for x in p.support %}<li data-t>{{ node(x) }}</li>{% endfor %}</ul>{% endif %}
  {% endif %}
  </div>
  <div class="foot">
    <div class="src" data-t data-chrome>{% if p.pending_count %}<span class="legend">● 待人工确认 {{ p.pending_count }} 项</span>　{% endif %}{% if p.sources_line %}来源：{{ p.sources_line }}{% endif %}</div>
    <div class="pg" data-t data-chrome>{{ "%02d"|format(loop.index) }}</div>
  </div>
{% endif %}
</section>
{% endfor %}
</body>
</html>
