# Set these to the installed, qualified Artifact Tool and presentation finalizer.
# Paths are deployment configuration; no developer-machine path is a default.
EASYPPT_ARTIFACT_NODE=<node executable; optional when node is on PATH>
EASYPPT_ARTIFACT_NODE_MODULES=<directory containing @oai/artifact-tool>
EASYPPT_PRESENTATIONS_SKILL_DIR=<directory containing container_tools/artifact_tool_utils.mjs>
EASYPPT_ARTIFACT_BIN_DIR=<runtime tools directory; optional, defaults to node directory>
EASYPPT_ARTIFACT_PYTHON=<python executable; optional, defaults to current interpreter>
EASYPPT_BUILD_TMP=<writable build directory; optional>
