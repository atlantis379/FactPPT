{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceVersionChain v0.1",
  "type": "object",
  "required": ["schema_version", "sources", "relations", "effective_source_ids", "corrections", "effective_claim_ids"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "sha256", "version_label"], "properties": {"source_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version_label": {"type": "string"}}}},
    "relations": {"type": "array", "items": {"type": "object", "required": ["from_source_id", "to_source_id", "relation_type", "explicit_evidence_ref"], "properties": {"from_source_id": {"type": "string"}, "to_source_id": {"type": "string"}, "relation_type": {"enum": ["CORRECTED_BY", "AMENDED_BY", "SUPERSEDED_BY"]}, "explicit_evidence_ref": {"type": "string"}}}},
    "effective_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "effective_claim_ids": {"type": "array", "items": {"type": "string"}},
    "corrections": {"type": "array", "items": {"type": "object", "required": ["correction_id", "correction_notice_anchor", "old_fact", "effective_fact"], "properties": {"correction_id": {"type": "string"}, "correction_notice_anchor": {"type": "string"}, "old_fact": {"$ref": "#/$defs/fact"}, "effective_fact": {"$ref": "#/$defs/fact"}}}}
  },
  "$defs": {"fact": {"type": "object", "required": ["claim_id", "source_id", "status", "text"], "properties": {"claim_id": {"type": "string"}, "source_id": {"type": "string"}, "status": {"enum": ["SUPERSEDED", "EFFECTIVE"]}, "text": {"type": "string"}}}}
}
