{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_qualification_result.v0.2.schema.json",
  "title": "RuntimeQualificationResult v0.2",
  "type": "object",
  "required": [
    "qualification_run_id",
    "benchmark_pack_id",
    "runtime_profile_id",
    "executed_fixture_ids",
    "results",
    "capability_records",
    "overall_status",
    "schema_version",
    "runtime_ref",
    "runtime_sha256"
  ],
  "properties": {
    "qualification_run_id": {
      "type": "string"
    },
    "benchmark_pack_id": {
      "type": "string"
    },
    "runtime_profile_id": {
      "type": "string"
    },
    "runtime_profile_version": {
      "type": "string"
    },
    "material_change_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "executed_fixture_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "executor",
          "status",
          "verifier_results",
          "polarity"
        ],
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "executor": {
            "type": "object",
            "required": [
              "engine_id",
              "engine_version"
            ],
            "properties": {
              "engine_id": {
                "type": "string"
              },
              "engine_version": {
                "type": "string"
              },
              "implementation_class": {
                "type": "string"
              },
              "implementation_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": true
          },
          "input_fixture_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "execution_config_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_asset_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_asset_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation_output_manifest_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCK",
              "NOT_EXECUTED"
            ]
          },
          "verifier_results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "polarity": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "input_ref": {
            "type": "string",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_ref": {
            "type": "string",
            "minLength": 1
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "input_ref",
                "input_sha256",
                "output_ref",
                "output_sha256"
              ],
              "properties": {
                "verifier_results": {
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "status",
                      "verifier_id"
                    ],
                    "properties": {
                      "status": {
                        "const": "PASS"
                      },
                      "verifier_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "executor": {
                  "required": [
                    "implementation_sha256"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "capability_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_record_id",
          "engine_id",
          "engine_version",
          "capability",
          "qualification_status",
          "evidence_fixture_ids"
        ],
        "properties": {
          "capability_record_id": {
            "type": "string"
          },
          "engine_id": {
            "type": "string"
          },
          "engine_version": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "qualification_status": {
            "enum": [
              "QUALIFIED",
              "REFERENCE_QUALIFIED",
              "QUALIFIED_WITH_RESTRICTIONS",
              "NOT_QUALIFIED",
              "BLOCKED",
              "STALE"
            ]
          },
          "evidence_fixture_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invalidation_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "qualification_status": {
                  "enum": [
                    "QUALIFIED",
                    "REFERENCE_QUALIFIED",
                    "QUALIFIED_WITH_RESTRICTIONS"
                  ]
                }
              },
              "required": [
                "qualification_status"
              ]
            },
            "then": {
              "required": [
                "implementation_sha256",
                "scope",
                "limitations",
                "invalidation_triggers"
              ],
              "properties": {
                "evidence_fixture_ids": {
                  "minItems": 1
                },
                "limitations": {
                  "minItems": 1
                },
                "invalidation_triggers": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "PARTIAL_PASS",
        "BLOCKED",
        "FAIL"
      ]
    },
    "schema_version": {
      "const": "0.2"
    },
    "runtime_ref": {
      "type": "string",
      "minLength": 1
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "enum": [
              "PASS",
              "PASS_WITH_WARNINGS"
            ]
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "executed_fixture_ids": {
            "minItems": 1
          },
          "results": {
            "minItems": 1
          },
          "capability_records": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
