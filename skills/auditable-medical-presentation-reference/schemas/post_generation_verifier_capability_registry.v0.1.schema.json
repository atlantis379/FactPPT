{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "post_generation_verifier_capability_registry.v0.1.schema.json",
  "title": "PostGenerationVerifierCapabilityRegistry v0.1",
  "type": "object",
  "required": ["registry_id","registry_version","status","validators"],
  "properties": {
    "registry_id": {"type":"string"},
    "registry_version": {"type":"string"},
    "status": {"enum":["QUALIFIED","REFERENCE_QUALIFIED","PARTIALLY_QUALIFIED","UNQUALIFIED","STALE"]},
    "validators": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["verifier_capability_id","verifier_version","verification_targets","authority_level","qualification_status","execution_mode","failure_action"],
        "properties": {
          "verifier_capability_id":{"type":"string"},
          "verifier_version":{"type":"string"},
          "verification_targets":{"type":"array","items":{"type":"string"}},
          "authority_level":{"enum":["AUTHORITATIVE","SECONDARY","HUMAN_REVIEW_ONLY"]},
          "qualification_status":{"enum":["QUALIFIED","REFERENCE_QUALIFIED","QUALIFIED_WITH_LIMITATIONS","UNQUALIFIED","STALE"]},
          "execution_mode":{"type":"string"},
          "required_input_artifacts":{"type":"array","items":{"type":"string"}},
          "output_artifact_type":{"type":"string"},
          "qualification_evidence_refs":{"type":"array","items":{"type":"string"}},
          "known_limitations":{"type":"array","items":{"type":"string"}},
          "failure_action":{"type":"string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
