{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native_beautification_plan.v0.1.schema.json",
  "title": "Native Editable PPTX Beautification Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer", "native_editable", "external_asset_policy", "tokens", "pages"],
  "properties": {
    "schema_version": {"const": "native_beautification_plan.v0.1"},
    "renderer": {"const": "artifact-tool-native-editable"},
    "native_editable": {"const": true},
    "semantic_deck_project_id": {"type": ["string", "null"]},
    "external_asset_policy": {
      "type": "object",
      "required": ["allowed_roles", "protected_native_roles", "providers", "default"],
      "properties": {
        "allowed_roles": {"type": "array", "items": {"enum": ["BACKGROUND_TEXTURE", "DECORATIVE_ILLUSTRATION", "NON_SEMANTIC_ICON"]}, "uniqueItems": true},
        "protected_native_roles": {"type": "array", "items": {"enum": ["TITLE", "PRIMARY_MESSAGE", "CLAIM", "NUMERIC_EVIDENCE", "SOURCE", "RELATIONSHIP"]}, "uniqueItems": true},
        "providers": {"type": "array", "items": {"enum": ["chatgpt-image", "figma"]}, "uniqueItems": true},
        "default": {"enum": ["DISABLED", "ENABLED_WITH_VALIDATED_MANIFEST"]}
      }
    },
    "tokens": {
      "type": "object",
      "required": ["canvas", "colors", "typography"],
      "properties": {
        "canvas": {
          "type": "object",
          "required": ["width", "height", "safe_margin"],
          "properties": {"width": {"const": 1280}, "height": {"const": 720}, "safe_margin": {"type": "integer", "minimum": 32}}
        },
        "colors": {"type": "object", "minProperties": 8},
        "typography": {"type": "object", "required": ["font_family", "title", "message", "body", "meta", "footer"]}
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "visual_type", "selected_archetype", "selection_score", "candidates", "elements", "connectors", "source_lines", "claim_ids", "relationship_ids", "editorial_assets", "fusion", "speaker_notes"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "visual_type": {"type": ["string", "null"]},
          "selected_archetype": {"enum": ["EDITORIAL_STATEMENT", "EVIDENCE_CARDS", "COMPARISON_COLUMNS", "DECISION_FLOW", "TIMELINE"]},
          "selection_score": {"type": "integer"},
          "candidates": {
            "type": "array", "minItems": 5, "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["archetype", "status", "score", "reasons"],
              "properties": {
                "archetype": {"enum": ["EDITORIAL_STATEMENT", "EVIDENCE_CARDS", "COMPARISON_COLUMNS", "DECISION_FLOW", "TIMELINE"]},
                "status": {"enum": ["VALID", "REJECTED"]},
                "score": {"type": ["integer", "null"]},
                "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "elements": {
            "type": "array", "minItems": 7,
            "items": {
              "type": "object",
              "required": ["kind", "name", "position"],
              "properties": {
                "kind": {"enum": ["text", "shape"]},
                "name": {"type": "string", "minLength": 1},
                "geometry": {"type": "string"},
                "position": {
                  "type": "object", "additionalProperties": false,
                  "required": ["left", "top", "width", "height"],
                  "properties": {
                    "left": {"type": "integer", "minimum": 0, "maximum": 1279},
                    "top": {"type": "integer", "minimum": 0, "maximum": 719},
                    "width": {"type": "integer", "minimum": 1, "maximum": 1280},
                    "height": {"type": "integer", "minimum": 1, "maximum": 720}
                  }
                },
                "fill": {"type": "string"},
                "line": {"type": "object"},
                "text": {"type": "string"},
                "style": {"type": "object"}
              }
            }
          },
          "connectors": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "from", "to", "color", "direction"],
              "properties": {"name": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "color": {"type": "string"}, "width": {"type": "number", "minimum": 1}, "direction": {"enum": ["FORWARD", "BIDIRECTIONAL", "NONE"]}}
            }
          },
          "source_lines": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "claim_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
          "relationship_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "editorial_assets": {
            "type": "array", "maxItems": 1,
            "items": {
              "type": "object",
              "required": ["asset_id", "provider", "asset_class", "layer_role", "path", "sha256", "content_type", "placement", "content_review"],
              "properties": {
                "asset_id": {"type": "string"}, "provider": {"const": "chatgpt-image"},
                "asset_class": {"const": "NONSEMANTIC_EDITORIAL_BASE"}, "layer_role": {"const": "EDITORIAL_UNDERLAY"},
                "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
                "content_type": {"const": "image/png"}, "placement": {"type": "object"}, "content_review": {"type": "object"}
              }
            }
          },
          "fusion": {
            "type": "object", "additionalProperties": false,
            "required": ["enabled", "variant"],
            "properties": {
              "enabled": {"type": "boolean"},
              "variant": {"enum": ["NONE", "OPEN_FIELD", "SOFT_CARDS", "SPLIT_FIELD", "RHYTHM_BANDS", "FLOW_NODES"]},
              "asset_id": {"type": "string"},
              "reuse_mode": {"const": "MASTER_UNDERLAY"},
              "content_zone": {"type": "object"},
              "protected_decoration_zone": {"type": "object"},
              "surface_policy": {"const": "TRANSLUCENT_OR_OPEN_NATIVE_SURFACES"}
            }
          },
          "speaker_notes": {"type": "array", "minItems": 3, "items": {"type": "string"}}
        }
      }
    }
  }
}
