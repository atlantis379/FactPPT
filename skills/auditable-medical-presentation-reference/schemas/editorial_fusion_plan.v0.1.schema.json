{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial_fusion_plan.v0.1.schema.json",
  "title": "EditorialFusionPlan v0.1",
  "type": "object",
  "required": [
    "fusion_plan_id", "fusion_plan_version", "source_identity", "page_id",
    "editorial_asset", "integration_mode", "semantic_layers", "editorial_zones",
    "protected_zones", "render_review"
  ],
  "properties": {
    "fusion_plan_id": {"type": "string", "minLength": 1},
    "fusion_plan_version": {"type": "string", "minLength": 1},
    "source_identity": {
      "type": "object",
      "required": ["source_sha256", "semantic_object_ids"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "semantic_object_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "page_id": {"type": "string", "minLength": 1},
    "editorial_asset": {
      "type": "object",
      "required": ["asset_id", "asset_sha256", "asset_class", "prompt_provenance_ref"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "asset_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "asset_class": {"const": "NONSEMANTIC_EDITORIAL_BASE"},
        "prompt_provenance_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "integration_mode": {"enum": ["EDGE_FRAMED", "FIELD_INTEGRATED", "SECTION_RHYTHM"]},
    "semantic_layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object_id", "source_anchor", "native_editable", "box", "z_order", "visual_relation"],
        "properties": {
          "object_id": {"type": "string", "minLength": 1},
          "source_anchor": {"type": "string", "minLength": 1},
          "native_editable": {"const": true},
          "box": {"$ref": "#/$defs/box"},
          "z_order": {"type": "integer", "minimum": 2},
          "visual_relation": {"enum": ["READING_ORDER", "GROUPING_ONLY", "EVIDENCE_EMPHASIS", "SEQUENCE_LICENSED_BY_SOURCE"]}
        },
        "additionalProperties": false
      }
    },
    "editorial_zones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["zone_id", "box", "role", "z_order"],
        "properties": {
          "zone_id": {"type": "string", "minLength": 1},
          "box": {"$ref": "#/$defs/box"},
          "role": {"enum": ["EDGE_TEXTURE", "LOWER_RHYTHM", "PALETTE_FIELD", "NEGATIVE_SPACE"]},
          "z_order": {"const": 0}
        },
        "additionalProperties": false
      }
    },
    "protected_zones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["zone_id", "box", "minimum_uncovered_area_ratio"],
        "properties": {
          "zone_id": {"type": "string", "minLength": 1},
          "box": {"$ref": "#/$defs/box"},
          "minimum_uncovered_area_ratio": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "render_review": {
      "type": "object",
      "required": ["reviewer_role", "status", "checked"],
      "properties": {
        "reviewer_role": {"enum": ["author", "independent"]},
        "status": {"enum": ["PASS", "FAIL", "NEEDS_REVIEW"]},
        "checked": {
          "type": "object",
          "required": ["background_visible", "semantic_text_legible", "visual_hierarchy_aligned", "no_semantic_replacement"],
          "properties": {
            "background_visible": {"type": "boolean"},
            "semantic_text_legible": {"type": "boolean"},
            "visual_hierarchy_aligned": {"type": "boolean"},
            "no_semantic_replacement": {"type": "boolean"}
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "box": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 4, "maxItems": 4}
  },
  "additionalProperties": false
}
